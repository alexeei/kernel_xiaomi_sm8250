--- fs/namespace.c
+++ fs/namespace.c
@@ -2004,7 +2005,7 @@ struct mount *copy_tree(struct mount *mnt, struct dentry *dentry,
 				goto out;
 #ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
             if (is_zygote_not_copy_mnt_ns &&
-				q->mnt_id < DEFAULT_SUS_MNT_ID) {
+				q->mnt_id < DEFAULT_KSU_MNT_ID) {
 					attach_mnt_count++;
 					q->mnt_id += attach_mnt_count;
 			}
@@ -3253,7 +3254,7 @@ struct mnt_namespace *copy_mnt_ns(unsigned long flags, struct mnt_namespace *ns,
 			break;
 #ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
 		// Here We are only interested in processes of which original mnt namespace belongs to zygote
-		if (likely(is_zygote_pid && (q->mnt_id < DEFAULT_SUS_MNT_ID))) {
+		if (likely(is_zygote_pid && (q->mnt_id < DEFAULT_KSU_MNT_ID))) {
 			// q->mnt.susfs_mnt_id_backup -> original mnt_id
 			// q->mnt_id -> to be modified to the fake mnt_id
 			q->mnt.susfs_mnt_id_backup = q->mnt_id;
@@ -3822,7 +3823,7 @@ void susfs_run_try_umount_for_current_mnt_ns(void) {
        namespace_lock();
        list_for_each_entry(mnt, &mnt_ns->list, mnt_list) {
                // Change the sus mount to be private
-               if (mnt->mnt_id >= DEFAULT_SUS_MNT_ID) {
+               if (mnt->mnt_id >= DEFAULT_KSU_MNT_ID) {
                        change_mnt_propagation(mnt, MS_PRIVATE);
                }
        }
